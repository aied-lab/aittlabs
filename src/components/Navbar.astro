---
const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');
const lang = isEn ? 'en' : 'zh';

const t = {
  zh: {
    home: '首頁',
    institute: '研訓院',
    products: '產品',
    consulting: '顧問服務',
    insights: '洞察觀點',
    curation: '學習策展',
    about: '關於我們',
    contact: '聯絡我們',
  },
  en: {
    home: 'Home',
    institute: 'Institute',
    products: 'Products',
    consulting: 'Consulting',
    insights: 'Insights',
    curation: 'Curation',
    about: 'About',
    contact: 'Contact',
  },
}[lang];

const enVersionMap: Record<string, string> = {
  '/': '/en/',
  '/institute/': '/en/institute/',
  '/products/': '/en/products/',
  '/consulting/': '/en/consulting/',
  '/insights/': '/en/insights/',
  '/curation/': '/curation/',
  '/about/': '/en/about/',
  '/contact/': '/en/contact/',
};

const linkFor = (zhPath: string) =>
  lang === 'en' && enVersionMap[zhPath] ? enVersionMap[zhPath] : zhPath;

const links = [
  { href: linkFor('/'), label: t.home },
  { href: linkFor('/institute/'), label: t.institute },
  { href: linkFor('/products/'), label: t.products },
  { href: linkFor('/consulting/'), label: t.consulting },
  { href: linkFor('/insights/'), label: t.insights },
  { href: linkFor('/curation/'), label: t.curation },
  { href: linkFor('/about/'), label: t.about },
];

const contactHref = linkFor('/contact/');

const switcherTarget = (() => {
  if (lang === 'en') {
    return currentPath.replace(/^\/en/, '') || '/';
  }
  return enVersionMap[currentPath] ?? '/en/about/';
})();
---

<nav id="navbar">
  <div class="nav-inner container">
    <a href={lang === 'en' ? '/en/' : '/'} class="nav-logo">
      <img src="/images/logo.png" alt="AITT Labs" class="logo-icon" width="40" height="40" />
      <span class="logo-text-group">
        <span class="logo-text-en">AI TalenTech Labs</span>
        <span class="logo-text-zh">AI 人才科技實驗室</span>
      </span>
    </a>
    <button class="mobile-toggle" id="menuToggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
    <div class="nav-links" id="navLinks">
      {links.map(link => (
        <a href={link.href} class:list={[{ active: currentPath === link.href }]}>
          {link.label}
        </a>
      ))}
      <span class="lang-switch" aria-label="Language">
        <a
          href={lang === 'zh' ? currentPath : switcherTarget}
          class:list={[{ active: lang === 'zh' }]}
          aria-current={lang === 'zh' ? 'true' : 'false'}
        >中</a>
        <span class="lang-divider" aria-hidden="true">|</span>
        <a
          href={lang === 'en' ? currentPath : switcherTarget}
          class:list={[{ active: lang === 'en' }]}
          aria-current={lang === 'en' ? 'true' : 'false'}
        >EN</a>
      </span>
      <a href={contactHref} class="nav-cta">{t.contact}</a>
    </div>
  </div>
</nav>

<style>
  nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 0;
    background: rgba(11, 17, 32, 0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border);
    transition: all 0.3s;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo-icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 6px;
  }
  .logo-text-group {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .logo-text-en {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: #F1F5F9;
  }
  .logo-text-zh {
    font-size: 0.95rem;
    color: var(--gold-light);
    font-weight: 500;
    letter-spacing: 0.15em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }
  .nav-links > a {
    color: var(--text-dim);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s;
    letter-spacing: 0.01em;
  }
  .nav-links > a:hover,
  .nav-links > a.active {
    color: var(--accent-light);
  }
  .nav-cta {
    background: var(--accent) !important;
    color: #fff !important;
    padding: 0.5rem 1.25rem !important;
    border-radius: var(--radius-sm) !important;
    font-weight: 600 !important;
  }
  .nav-cta:hover {
    background: var(--accent-light) !important;
    transform: translateY(-1px);
  }
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .lang-switch a {
    color: var(--text-muted);
    font-weight: 500;
    transition: color 0.2s;
  }
  .lang-switch a:hover {
    color: var(--accent-light);
  }
  .lang-switch a.active {
    color: var(--text);
    font-weight: 700;
    pointer-events: none;
    cursor: default;
  }
  .lang-divider {
    color: var(--text-muted);
    opacity: 0.5;
  }
  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .mobile-toggle span {
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
    transition: all 0.3s;
  }
  @media (max-width: 768px) {
    .mobile-toggle { display: flex; }
    .nav-links {
      display: none;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: rgba(11, 17, 32, 0.97);
      padding: 1.5rem 2rem;
      border-bottom: 1px solid var(--border);
      gap: 1rem;
    }
    .nav-links.open { display: flex; }
  }
</style>

<script>
  document.getElementById('menuToggle')?.addEventListener('click', () => {
    document.getElementById('navLinks')?.classList.toggle('open');
  });
</script>
