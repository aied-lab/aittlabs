---
interface Props {
  lang?: 'zh' | 'en';
}

const { lang = 'zh' } = Astro.props;

const CHAT_URL =
  'https://script.google.com/macros/s/AKfycby-vmZ9GIQdroGbjarQSF3JDxooshunsD6uNG83PVTr2f41nSYHeAsvJssf_4waE99xSg/exec';

const t = {
  zh: {
    label: '預約諮詢',
    title: 'AIbot 愛寶｜行程預約助理',
    close: '關閉聊天視窗',
    loading: '小幫手載入中…',
  },
  en: {
    label: 'Book a Meeting',
    title: 'AIbot — Booking Assistant',
    close: 'Close chat window',
    loading: 'Loading assistant…',
  },
}[lang];
---

<div class="chat-widget">
  <div class="chat-panel" id="chatPanel" role="dialog" aria-label={t.title} hidden>
    <div class="chat-panel-header">
      <span class="chat-panel-title">
        <span class="chat-status-dot"></span>
        {t.title}
      </span>
      <button class="chat-close" id="chatClose" aria-label={t.close}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="chat-panel-body">
      <div class="chat-loading" id="chatLoading">
        <span class="chat-spinner"></span>
        {t.loading}
      </div>
      <iframe
        id="chatFrame"
        data-src={CHAT_URL}
        title={t.title}
        allow="clipboard-write"
      ></iframe>
    </div>
  </div>

  <button class="chat-launcher" id="chatLauncher" aria-expanded="false" aria-controls="chatPanel">
    <svg class="chat-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    <svg class="chat-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M18 6L6 18M6 6l12 12"/></svg>
    <span class="chat-launcher-label">{t.label}</span>
  </button>
</div>

<style>
  .chat-widget {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.9rem;
  }

  .chat-launcher {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.35rem;
    border: none;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), #2563EB);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.35);
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .chat-launcher:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(59, 130, 246, 0.45);
  }
  .chat-launcher .chat-icon-close { display: none; }
  .chat-widget.open .chat-icon-open { display: none; }
  .chat-widget.open .chat-icon-close { display: block; }

  .chat-panel {
    width: min(400px, calc(100vw - 3rem));
    height: min(620px, calc(100vh - 140px));
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition: opacity 0.25s ease, transform 0.25s ease;
    pointer-events: none;
  }
  .chat-widget.open .chat-panel {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .chat-panel-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }
  .chat-panel-title {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text);
  }
  .chat-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 8px rgba(20, 184, 166, 0.8);
  }
  .chat-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 50%;
    background: transparent;
    color: var(--text-dim);
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .chat-close:hover {
    background: var(--surface-3);
    color: var(--text);
  }

  .chat-panel-body {
    position: relative;
    flex: 1;
    background: #fff;
  }
  .chat-panel-body iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
  }
  .chat-loading {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    background: var(--surface);
    color: var(--text-dim);
    font-size: 0.9rem;
    z-index: 1;
    transition: opacity 0.3s;
  }
  .chat-loading.done {
    opacity: 0;
    pointer-events: none;
  }
  .chat-spinner {
    width: 28px;
    height: 28px;
    border: 3px solid var(--surface-3);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: chat-spin 0.8s linear infinite;
  }
  @keyframes chat-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 640px) {
    .chat-widget {
      bottom: 1rem;
      right: 1rem;
    }
    .chat-launcher-label {
      display: none;
    }
    .chat-launcher {
      padding: 0.95rem;
    }
    .chat-widget.open .chat-panel {
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      height: 100dvh;
      border-radius: 0;
      border: none;
    }
  }
</style>

<script>
  const widget = document.querySelector('.chat-widget') as HTMLElement;
  const launcher = document.getElementById('chatLauncher') as HTMLButtonElement;
  const panel = document.getElementById('chatPanel') as HTMLElement;
  const closeBtn = document.getElementById('chatClose') as HTMLButtonElement;
  const frame = document.getElementById('chatFrame') as HTMLIFrameElement;
  const loading = document.getElementById('chatLoading') as HTMLElement;

  let loaded = false;

  function openChat() {
    if (!loaded) {
      loaded = true;
      frame.addEventListener('load', () => loading.classList.add('done'), { once: true });
      frame.src = frame.dataset.src || '';
      const w = window as any;
      if (typeof w.gtag === 'function') w.gtag('event', 'chat_open');
    }
    panel.hidden = false;
    requestAnimationFrame(() => widget.classList.add('open'));
    launcher.setAttribute('aria-expanded', 'true');
  }

  function closeChat() {
    widget.classList.remove('open');
    launcher.setAttribute('aria-expanded', 'false');
    setTimeout(() => { if (!widget.classList.contains('open')) panel.hidden = true; }, 250);
  }

  launcher.addEventListener('click', () => {
    widget.classList.contains('open') ? closeChat() : openChat();
  });
  closeBtn.addEventListener('click', closeChat);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && widget.classList.contains('open')) closeChat();
  });

  document.querySelectorAll('[data-open-chat]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openChat();
    });
  });
</script>
