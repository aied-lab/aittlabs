---
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
const isEn = currentPath.startsWith('/en');
const lang = isEn ? 'en' : 'zh';

const t = {
  zh: {
    tagline: '用 AI 重新定義人才發展與組織轉型',
    products: '產品',
    services: '服務',
    services_items: {
      institute: 'AI 人才科技研訓院',
      strategy: 'AI 組織人才發展策略',
      blueprint: 'AI 組織轉型藍圖規劃',
      adoption: 'AI 創新應用落地輔導',
      learning: 'AI 數位學習課程設計',
    },
    links: '連結',
    research: '研究',
    insights: '專欄',
    about: '關於',
    contact: '聯絡我們',
    course_platform: '課程平台',
    rights: 'All rights reserved.',
  },
  en: {
    tagline: 'Redefining talent development and organizational transformation through AI',
    products: 'Products',
    services: 'Services',
    services_items: {
      institute: 'AI TalenTech Institute',
      strategy: 'AI Talent Development Strategy',
      blueprint: 'AI Transformation Roadmap',
      adoption: 'AI Adoption & Implementation',
      learning: 'AI Digital Learning Design',
    },
    links: 'Links',
    research: 'Research',
    insights: 'Insights',
    about: 'About',
    contact: 'Contact',
    course_platform: 'Course Platform',
    rights: 'All rights reserved.',
  },
}[lang];

const enVersionMap: Record<string, string> = {
  '/': '/en/',
  '/institute/': '/en/institute/',
  '/products/': '/en/products/',
  '/consulting/': '/en/consulting/',
  '/insights/': '/en/insights/',
  '/about/': '/en/about/',
  '/contact/': '/en/contact/',
};
const linkFor = (zhPath: string) =>
  lang === 'en' && enVersionMap[zhPath] ? enVersionMap[zhPath] : zhPath;
---

<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href={lang === 'en' ? '/en/' : '/'} class="footer-logo-row">
          <img src="/images/logo.png" alt="AITT Labs" width="40" height="40" class="footer-logo-icon" />
          <span class="footer-logo-text-group">
            <span class="footer-logo-text-en">AI TalenTech Labs</span>
            <span class="footer-logo-text-zh">AI 人才科技實驗室</span>
          </span>
        </a>
        <p>{t.tagline}</p>
      </div>
      <div class="footer-col">
        <h4>{t.products}</h4>
        <a href={linkFor('/products/')}>AI Interviewer</a>
        <a href={linkFor('/products/')}>iCoach360</a>
        <a href={linkFor('/products/')}>PPTutor</a>
        <a href={linkFor('/products/')}>Systemaster</a>
        <a href={linkFor('/products/')}>FlowMaster</a>
        <a href={linkFor('/products/')}>Courstart.ai</a>
      </div>
      <div class="footer-col">
        <h4>{t.services}</h4>
        <a href={linkFor('/institute/')}>{t.services_items.institute}</a>
        <a href={linkFor('/consulting/')}>{t.services_items.strategy}</a>
        <a href={linkFor('/consulting/')}>{t.services_items.blueprint}</a>
        <a href={linkFor('/consulting/')}>{t.services_items.adoption}</a>
        <a href={linkFor('/consulting/')}>{t.services_items.learning}</a>
      </div>
      <div class="footer-col">
        <h4>{t.links}</h4>
        <a href={linkFor('/research/')}>{t.research}</a>
        <a href={linkFor('/insights/')}>{t.insights}</a>
        <a href={linkFor('/about/')}>{t.about}</a>
        <a href={linkFor('/contact/')}>{t.contact}</a>
        <a href="https://aitti.online" target="_blank">{t.course_platform}</a>
        <a href="https://substack.com/@johnliontw" target="_blank">Substack</a>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; {year} AI TalenTech Labs. {t.rights}</p>
      <div class="footer-social">
        <a href="https://www.youtube.com/@ai-talentech-labs" target="_blank" aria-label="YouTube">YT</a>
        <a href="https://www.facebook.com/ai.talentech.labs" target="_blank" aria-label="Facebook">FB</a>
        <a href="https://substack.com/@johnliontw" target="_blank" aria-label="Substack">SS</a>
        <a href="mailto:service@aittlabs.org" aria-label="Email">Email</a>
      </div>
    </div>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding: 4rem 0 2rem;
    background: var(--primary);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }
  .footer-logo-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1rem;
  }
  .footer-logo-icon {
    width: 40px;
    height: 40px;
    object-fit: contain;
    border-radius: 6px;
  }
  .footer-logo-text-group {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .footer-logo-text-en {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.1rem;
    color: #F1F5F9;
  }
  .footer-logo-text-zh {
    font-size: 0.95rem;
    color: var(--gold-light);
    font-weight: 500;
    letter-spacing: 0.15em;
  }
  .footer-brand p {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .footer-col h4 {
    font-family: var(--font-display);
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--text);
  }
  .footer-col a {
    display: block;
    color: var(--text-muted);
    font-size: 0.85rem;
    padding: 0.3rem 0;
    transition: color 0.3s;
  }
  .footer-col a:hover { color: var(--accent-light); }
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .footer-bottom p {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .footer-social {
    display: flex;
    gap: 1rem;
  }
  .footer-social a {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 500;
    transition: color 0.3s;
  }
  .footer-social a:hover { color: var(--accent-light); }
  @media (max-width: 768px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .footer-bottom { flex-direction: column; gap: 1rem; text-align: center; }
  }
</style>
