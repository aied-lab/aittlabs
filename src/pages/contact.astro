---
import Base from '../layouts/Base.astro';
---

<Base title="聯絡我們">
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Contact</span>
      <h1>與我們<span class="highlight">聯繫</span></h1>
      <p>無論是產品諮詢、培訓合作、或是顧問服務需求，歡迎與我們聯繫，我們將盡速回覆。</p>
    </div>
  </section>

  <section>
    <div class="container contact-container">
      <div class="contact-form-wrapper">
        <h3>留下您的需求</h3>
        <form class="contact-form" action="https://formsubmit.co/service@aittlabs.org" method="POST">
          <input type="hidden" name="_subject" value="AITT Labs 官網諮詢" />
          <input type="hidden" name="_captcha" value="false" />
          <input type="hidden" name="_next" value="https://aittlabs.org/contact/?sent=true" />
          <input type="text" name="_honey" style="display:none" />
          <div class="form-row">
            <div class="form-group">
              <label for="name">姓名</label>
              <input type="text" id="name" name="name" placeholder="您的姓名" required />
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" placeholder="your@email.com" required />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label for="org">公司 / 機關</label>
              <input type="text" id="org" name="org" placeholder="您的組織名稱" />
            </div>
            <div class="form-group">
              <label for="interest">感興趣的服務</label>
              <select id="interest" name="interest">
                <option value="">請選擇</option>
                <option value="products">AI 模擬教練產品</option>
                <option value="institute">培訓課程合作</option>
                <option value="consulting">顧問服務</option>
                <option value="other">其他</option>
              </select>
            </div>
          </div>
          <div class="form-group">
            <label for="message">訊息內容</label>
            <textarea id="message" name="message" placeholder="請簡述您的需求..." rows="5"></textarea>
          </div>
          <button type="submit" class="btn btn-primary form-submit">送出諮詢</button>
        </form>
      </div>

      <div class="contact-email">
        <span class="ci-icon">✉</span>
        <span class="ci-text">或直接來信</span>
        <a href="mailto:service@aittlabs.org">service@aittlabs.org</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-container {
    max-width: 720px;
  }
  .contact-email {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .ci-icon {
    font-size: 1.1rem;
  }
  .ci-text {
    color: var(--text-muted);
  }
  .contact-email a {
    color: var(--accent-light);
    font-weight: 600;
  }
  .contact-email a:hover {
    color: var(--gold);
  }

  .contact-form-wrapper {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
  }
  .contact-form-wrapper h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .form-group {
    margin-bottom: 1.25rem;
  }
  .form-group label {
    display: block;
    color: var(--text-dim);
    font-size: 0.85rem;
    margin-bottom: 0.5rem;
    font-weight: 500;
  }
  .form-group input,
  .form-group textarea,
  .form-group select {
    width: 100%;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--primary);
    border: 1px solid var(--border);
    color: var(--text);
    font-size: 0.95rem;
    font-family: inherit;
    transition: border-color 0.3s;
    outline: none;
  }
  .form-group input:focus,
  .form-group textarea:focus,
  .form-group select:focus {
    border-color: var(--accent);
  }
  .form-group textarea { resize: vertical; }
  .form-group select option { background: var(--surface); }
  .form-submit {
    width: 100%;
    padding: 1rem;
    font-size: 1rem;
  }
  @media (max-width: 768px) {
    .form-row { grid-template-columns: 1fr; }
  }
</style>
