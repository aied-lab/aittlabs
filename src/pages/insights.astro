---
import Base from '../layouts/Base.astro';

type Article = { title: string; link: string; date: Date; summary: string; source: string };

// Fetch Substack via JSON API (more reliable than RSS in CI environments)
let substackArticles: Article[] = [];
try {
  const res = await fetch('https://aiedlab.substack.com/api/v1/posts?limit=50');
  const posts = await res.json() as any[];
  substackArticles = posts
    .filter((p: any) => p.audience === 'everyone' || p.audience === 'only_free')
    .map((p: any) => ({
      title: p.title,
      link: p.canonical_url,
      date: new Date(p.post_date),
      summary: (p.subtitle || p.description || '').slice(0, 120) + '...',
      source: 'Substack' as const,
    }));
} catch (e) {
  console.error('Failed to fetch Substack:', e);
}

// Fetch CIO Taiwan RSS
let cioArticles: Article[] = [];
try {
  const res = await fetch('https://www.cio.com.tw/author/author2/feed/', {
    headers: { 'User-Agent': 'Mozilla/5.0 (compatible; ASTROBot/1.0)' },
  });
  const xml = await res.text();
  const items = xml.match(/<item>([\s\S]*?)<\/item>/g) || [];
  cioArticles = items.map(item => {
    const title = item.match(/<title><!\[CDATA\[(.*?)\]\]><\/title>/)?.[1]
      || item.match(/<title>(.*?)<\/title>/)?.[1] || '';
    const link = item.match(/<link>(.*?)<\/link>/)?.[1]
      || item.match(/<link\/>\s*(https?:\/\/[^\s<]+)/)?.[1] || '';
    const pubDate = item.match(/<pubDate>(.*?)<\/pubDate>/)?.[1] || '';
    const desc = item.match(/<description><!\[CDATA\[(.*?)\]\]><\/description>/)?.[1]
      || item.match(/<description>(.*?)<\/description>/)?.[1] || '';
    const summary = desc.replace(/<[^>]*>/g, '').replace(/&#(\d+);/g, (_: string, n: string) => String.fromCharCode(Number(n))).replace(/&[^;]+;/g, '').slice(0, 120) + '...';
    return { title, link, date: new Date(pubDate), summary, source: 'CIO Taiwan' as const };
  });
} catch (e) {
  console.error('Failed to fetch CIO Taiwan RSS:', e);
}

// Merge and sort by date (newest first)
const allArticles = [...substackArticles, ...cioArticles].sort((a, b) => b.date.getTime() - a.date.getTime());

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title="洞察觀點" description="廖肇弘博士的 AI 人才科技趨勢分析、產業洞察與策略思考。">
  <section class="page-hero">
    <div class="container">
      <span class="section-label animate-on-scroll">Insights</span>
      <h1 class="animate-on-scroll">洞察觀點</h1>
      <p class="animate-on-scroll">AI 人才科技趨勢分析、產業洞察與策略思考</p>
    </div>
  </section>

  <section class="insights-section">
    <div class="container">
      <!-- Source filter -->
      <div class="filter-bar animate-on-scroll">
        <button class="filter-btn active" data-filter="all">全部</button>
        <button class="filter-btn" data-filter="Substack">Substack</button>
        <button class="filter-btn" data-filter="CIO Taiwan">CIO Taiwan</button>
      </div>

      <div class="articles-grid">
        {allArticles.map(article => (
          <a href={article.link} target="_blank" rel="noopener noreferrer"
             class="card article-card animate-on-scroll" data-source={article.source}>
            <div class="article-meta">
              <span class={`source-tag ${article.source === 'Substack' ? 'tag-substack' : 'tag-cio'}`}>
                {article.source}
              </span>
              <span class="article-date">{formatDate(article.date)}</span>
            </div>
            <h3>{article.title}</h3>
            <p>{article.summary}</p>
            <span class="read-more">
              閱讀全文
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                <path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        ))}
      </div>

      {allArticles.length === 0 && (
        <div class="empty-state">
          <p>目前暫無文章，請稍後再試。</p>
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .insights-section {
    padding-top: 0;
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 2.5rem;
    flex-wrap: wrap;
  }
  .filter-btn {
    padding: 0.5rem 1.25rem;
    border-radius: 50px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 500;
    font-family: inherit;
    cursor: pointer;
    transition: all 0.3s;
  }
  .filter-btn:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }
  .filter-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* Articles grid */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .article-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all var(--transition);
  }
  .article-card.hidden {
    display: none;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .source-tag {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .tag-substack {
    background: rgba(255, 102, 0, 0.12);
    color: #FF6600;
  }
  .tag-cio {
    background: rgba(59, 130, 246, 0.12);
    color: var(--accent-light);
  }

  .article-date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .article-card h3 {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .article-card p {
    color: var(--text-dim);
    font-size: 0.88rem;
    line-height: 1.7;
    flex: 1;
  }

  .read-more {
    color: var(--accent-light);
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.3s;
  }
  .article-card:hover .read-more {
    gap: 0.6rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Filter functionality
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = (btn as HTMLElement).dataset.filter;
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      document.querySelectorAll('.article-card').forEach(card => {
        const source = (card as HTMLElement).dataset.source;
        if (filter === 'all' || source === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Scroll animation
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const delay = Array.from(el.parentElement?.children ?? [])
          .filter(c => c.classList.contains('animate-on-scroll'))
          .indexOf(el) * 100;
        setTimeout(() => el.classList.add('visible'), Math.min(delay, 500));
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
</script>
