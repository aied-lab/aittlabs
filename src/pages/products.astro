---
import Base from '../layouts/Base.astro';

const products = [
  {
    name: 'AI Interviewer',
    nameZh: 'AI 面試官',
    desc: '模擬真實面試場景的 AI 系統，支援多輪對話、即時評估與詳細回饋報告。適用於求職者面試準備、企業 HR 篩選流程優化、以及公務人員甄選模擬。',
    features: ['多輪深度追問', '即時表情與語調分析', '客製化評分標準', '詳細評估報告輸出'],
    tag: 'Recruitment',
    color: 'tag-product',
    image: '/images/ai-interviewer-screenshot.jpg',
  },
  {
    name: 'iCoach360',
    nameZh: '高擬真情境模擬教練',
    desc: '360 度沉浸式情境模擬系統，將真實工作場景轉化為 AI 驅動的練習環境。主管可以在安全的模擬環境中反覆練習高難度對話、危機處理、跨部門協調等情境。',
    features: ['多角色情境扮演', '即時教練回饋', '能力雷達圖分析', '客製化企業情境'],
    tag: 'Leadership',
    color: 'tag-product',
    image: '/images/icoach360-screenshot.jpg',
  },
  {
    name: 'PPTutor',
    nameZh: '簡報提案模擬教練',
    desc: 'AI 模擬審查委員與評審團，針對你的簡報內容進行即時提問、挑戰與回饋。無論是政府標案提案、董事會報告、或是創業 Pitch，都能在上場前充分準備。',
    features: ['AI 模擬多位評審', '針對內容邏輯追問', '簡報結構建議', '限時壓力模擬'],
    tag: 'Presentation',
    color: 'tag-product',
    image: '/images/pptutor-screenshot.jpg',
  },
  {
    name: 'Systemaster',
    nameZh: '系統思考大師',
    desc: '以系統動力學（System Dynamics）為基礎的 AI 輔助分析工具，幫助組織從全局視角理解複雜問題的因果結構，找出關鍵槓桿點。',
    features: ['因果循環圖（CLD）自動生成', '系統基模識別與分析', '策略情境模擬', '組織動態分析報告'],
    tag: 'Systems Thinking',
    color: 'tag-consulting',
    image: '/images/systemaster-screenshot.jpg',
  },
  {
    name: 'FlowMaster',
    nameZh: '流程大師',
    desc: 'AI 驅動的流程分析與優化系統，將組織的業務流程視覺化、數位化，找出瓶頸與改善機會，設計最佳流程方案。',
    features: ['流程自動建模與視覺化', '瓶頸識別與效率分析', 'AI 改善方案建議', '導入前後效益評估'],
    tag: 'Process Optimization',
    color: 'tag-consulting',
    image: '/images/flowmaster-screenshot.jpg',
  },
  {
    name: 'Courstart.ai',
    nameZh: 'AI 智慧課程生成',
    desc: 'AI 全自動智慧生成數位教學內容，從課程架構規劃、教材內容撰寫到多媒體素材製作，一鍵完成高品質數位課程開發，大幅縮短製課時間。',
    features: ['課程架構自動生成', '教材內容智慧撰寫', '多媒體教學素材製作', '多格式數位課程輸出'],
    tag: 'Course Design',
    color: 'tag-product',
    image: '/images/courstart-screenshot.jpg',
  },
];
---

<Base title="產品">
  <section class="page-hero">
    <div class="container">
      <span class="section-label">Products</span>
      <h1>AI 人才科技<span class="highlight">產品系列</span></h1>
      <p>以生成式 AI 驅動的模擬教練與方法論工具，涵蓋面試、領導力訓練、簡報提案、系統思考與流程優化。</p>
    </div>
  </section>

  <section class="products-detail">
    <div class="container">
      {products.map((product, i) => (
        <div class:list={['product-row', { reverse: i % 2 === 1 }]}>
          <div class="product-info">
            <span class={`tag ${product.color}`}>{product.tag}</span>
            <h2>{product.name}</h2>
            <h3>{product.nameZh}</h3>
            <p>{product.desc}</p>
            <ul class="feature-list">
              {product.features.map(f => (
                <li>{f}</li>
              ))}
            </ul>
            <a href="/contact/" class="btn btn-primary">預約 Demo →</a>
          </div>
          <div class="product-visual">
            <div class="screenshot-wrapper">
              <img src={product.image} alt={`${product.nameZh} 產品截圖`} loading="lazy" />
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
</Base>

<style>
  .products-detail {
    padding-bottom: 4rem;
  }
  .product-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
  }
  .product-row:last-child { border-bottom: none; }
  .product-row.reverse { direction: rtl; }
  .product-row.reverse > * { direction: ltr; }
  .product-info { display: flex; flex-direction: column; gap: 0.75rem; }
  .product-info h2 {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .product-info h3 {
    font-size: 1.1rem;
    color: var(--text-dim);
    font-weight: 400;
    margin-bottom: 0.5rem;
  }
  .product-info p {
    color: var(--text-dim);
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 1rem 0;
  }
  .feature-list li {
    color: var(--text-dim);
    font-size: 0.9rem;
    padding-left: 1.5rem;
    position: relative;
  }
  .feature-list li::before {
    content: '✦';
    position: absolute;
    left: 0;
    color: var(--accent-light);
    font-size: 0.7rem;
    top: 0.2rem;
  }
  .product-visual {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .screenshot-wrapper {
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .screenshot-wrapper:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.4);
  }
  .screenshot-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }
  @media (max-width: 768px) {
    .product-row {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .product-row.reverse { direction: ltr; }
  }
</style>
