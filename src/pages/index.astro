---
import Base from '../layouts/Base.astro';
---

<Base title="首頁">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-banner-section">
      <img src="/images/aittlabs_banner.jpg" alt="AI TalenTech Labs" class="hero-banner" loading="eager" />
      <div class="hero-overlay"></div>
      <div class="hero-title container">
        <h1 class="animate-on-scroll">
          用 AI 重新定義<br>
          <span class="highlight">人才發展與組織轉型</span>
        </h1>
      </div>
    </div>
    <div class="hero-body">
      <div class="container">
        <p class="hero-subtitle animate-on-scroll">AI TalenTech Labs | AI 人才科技實驗室</p>
        <p class="hero-tagline animate-on-scroll">專注 AI 人工智慧 | TalenTech 人才科技 | EdTech 學習科技</p>
        <div class="hero-buttons animate-on-scroll">
          <a href="/products/" class="btn btn-primary">
            <span>探索產品</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/contact/" class="btn btn-outline">預約諮詢</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products & Services -->
  <section class="services-overview">
    <div class="container">
      <span class="section-label animate-on-scroll">Products & Services</span>
      <h2 class="section-title animate-on-scroll">產品及服務</h2>
      <div class="services-row">
        <a href="/institute/" class="card service-block animate-on-scroll">
          <div class="service-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5"/></svg>
          </div>
          <span class="tag tag-institute">Training</span>
          <h3>AI 人才科技研訓院</h3>
          <p>系統化的 AI 人才培訓方案，涵蓋 AI 素養、AI 應用實戰、AI 領導力等課程，已為數千名政府及企業學員提供培訓。</p>
          <span class="card-link">瀏覽課程 <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a href="/products/" class="card service-block animate-on-scroll">
          <div class="service-icon icon-coral">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <span class="tag tag-product">R&D</span>
          <h3>AI 人才科技研發</h3>
          <p>自主研發 AI 模擬教練系統，包括 AI Interviewer、iCoach360、PPTutor 等產品，以生成式 AI 驅動高擬真情境模擬訓練。</p>
          <span class="card-link">探索產品 <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a href="/consulting/" class="card service-block animate-on-scroll">
          <div class="service-icon icon-gold">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          </div>
          <span class="tag tag-consulting">Consulting</span>
          <h3>AI 人才科技顧問</h3>
          <p>運用 Systemaster 系統思考與 FlowMaster 流程優化方法論，為企業與政府機關量身打造 AI 轉型策略與落地方案。</p>
          <span class="card-link">了解服務 <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="clients-section">
    <div class="container">
      <span class="section-label animate-on-scroll">Track Record</span>
      <h2 class="section-title animate-on-scroll">服務實績</h2>
      <div class="clients-grid animate-on-scroll">
        <div class="client-chip">行政院人事行政總處</div>
        <div class="client-chip">國發會</div>
        <div class="client-chip">數發部</div>
        <div class="client-chip">經濟部</div>
        <div class="client-chip">教育部</div>
        <div class="client-chip">環境部</div>
        <div class="client-chip">勞動部</div>
        <div class="client-chip">原能會</div>
        <div class="client-chip">金管會</div>
        <div class="client-chip">移民署</div>
        <div class="client-chip">臺北市政府</div>
        <div class="client-chip">工業技術研究院</div>
        <div class="client-chip">國立清華大學</div>
        <div class="client-chip">中國文化大學</div>
        <div class="client-chip">Microsoft</div>
        <div class="client-chip">IBM</div>
        <div class="client-chip">PwC</div>
        <div class="client-chip">智園科技</div>
        <div class="client-chip">遠東集團</div>
        <div class="client-chip">CIO Taiwan</div>
      </div>
    </div>
  </section>

  <!-- Content Hub -->
  <section class="content-hub">
    <div class="container">
      <span class="section-label animate-on-scroll">Insights</span>
      <h2 class="section-title animate-on-scroll">內容專欄</h2>
      <div class="channels-grid">
        <a href="https://substack.com/@johnliontw" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
          </div>
          <h4>Substack 電子報</h4>
          <p>AI 人才科技趨勢分析、產業洞察與策略思考，每週更新。</p>
        </a>
        <a href="https://www.youtube.com/@ai-talentech-labs" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <h4>YouTube 頻道</h4>
          <p>AI TalenTech Labs — AI 人才科技趨勢、產品 Demo 與課程精華。</p>
        </a>
        <a href="https://www.facebook.com/ai.talentech.labs" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-fb">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <h4>Facebook 粉絲頁</h4>
          <p>AI 人才科技實驗室最新動態、活動資訊與產業觀點分享。</p>
        </a>
        <a href="https://aitti.online" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-teal">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h4>線上課程</h4>
          <p>AI 人才科技研訓院線上學習平台，實戰課程持續上架中。</p>
        </a>
        <a href="https://www.patreon.com/c/ai_talentech_labs" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-patreon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M14.82 2.41c3.96 0 7.18 3.24 7.18 7.21 0 3.96-3.22 7.18-7.18 7.18-3.97 0-7.21-3.22-7.21-7.18 0-3.97 3.24-7.21 7.21-7.21M2 21.6h3.5V2.41H2V21.6z"/></svg>
          </div>
          <h4>Patreon 會員</h4>
          <p>加入 AI TalenTech Labs 會員，取得獨家內容與深度分析。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-box animate-on-scroll">
        <div class="cta-glow"></div>
        <h2>準備好開啟 AI 轉型之旅？</h2>
        <p>無論是導入 AI 模擬教練、規劃人才培訓方案、或是啟動組織 AI 轉型策略，我們都能協助你找到最佳路徑。</p>
        <div class="cta-buttons">
          <a href="/contact/" class="btn btn-primary">預約免費諮詢 →</a>
          <a href="/products/" class="btn btn-outline">瀏覽產品</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== Hero ===== */
  .hero {
    padding: 0;
  }
  .hero-banner-section {
    position: relative;
    margin-top: 64px;
    overflow: hidden;
  }
  .hero-banner {
    width: 100%;
    height: auto;
    display: block;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 17, 32, 1) 0%,
      rgba(11, 17, 32, 0.85) 25%,
      rgba(11, 17, 32, 0.2) 60%,
      transparent 100%
    );
  }
  .hero-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding-bottom: 2rem;
    text-align: center;
  }
  .hero-title h1 {
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }
  .hero-body {
    padding: 2.5rem 0 3rem;
    text-align: center;
  }
  .hero-subtitle {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }
  .hero-tagline {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
    letter-spacing: 0.05em;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }


  /* ===== Products ===== */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    overflow: hidden;
  }
  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .product-card:hover .card-glow {
    opacity: 1;
  }
  .product-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--accent-glow);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-icon.icon-teal {
    background: rgba(20, 184, 166, 0.12);
    color: var(--teal);
  }
  .product-icon.icon-gold {
    background: rgba(245, 158, 11, 0.12);
    color: var(--gold);
  }
  .product-card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .product-card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    flex: 1;
    line-height: 1.7;
  }
  .card-link {
    color: var(--accent-light);
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.3s;
  }
  .product-card:hover .card-link,
  .service-block:hover .card-link {
    gap: 0.6rem;
  }

  /* ===== Services ===== */
  .services-overview {
    background: var(--surface);
  }
  .services-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .service-icon.icon-coral {
    background: rgba(249, 115, 22, 0.1);
    color: var(--coral);
  }
  .service-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .service-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background: rgba(20, 184, 166, 0.1);
    color: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .service-icon.icon-gold {
    background: rgba(245, 158, 11, 0.1);
    color: var(--gold);
  }
  .service-block h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .service-block p {
    color: var(--text-dim);
    font-size: 0.92rem;
    flex: 1;
    line-height: 1.7;
  }

  /* ===== Clients ===== */
  .clients-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .client-chip {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s;
  }
  .client-chip:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }

  /* ===== Content Hub ===== */
  .content-hub {
    background: var(--surface);
  }
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  .channel-icon-box.icon-fb {
    background: rgba(66, 103, 178, 0.12);
    color: #4267B2;
  }
  .channel-icon-box.icon-patreon {
    background: rgba(255, 66, 77, 0.12);
    color: #FF424D;
  }
  .channel-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .channel-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--accent-glow);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .channel-icon-box.icon-red {
    background: rgba(239, 68, 68, 0.12);
    color: #EF4444;
  }
  .channel-icon-box.icon-teal {
    background: rgba(20, 184, 166, 0.12);
    color: var(--teal);
  }
  .channel-card h4 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .channel-card p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* ===== CTA ===== */
  .cta-box {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 4rem;
    text-align: center;
  }
  .cta-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.08), transparent 70%);
    pointer-events: none;
  }
  .cta-box h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin-bottom: 1rem;
    position: relative;
  }
  .cta-box p {
    color: var(--text-dim);
    max-width: 550px;
    margin: 0 auto 2rem;
    position: relative;
  }
  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }

  /* ===== Scroll Animation ===== */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .products-grid,
    .services-row,
    .channels-grid {
      grid-template-columns: 1fr !important;
    }
    .cta-box { padding: 2.5rem 1.5rem; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const delay = Array.from(el.parentElement?.children ?? [])
          .filter(c => c.classList.contains('animate-on-scroll'))
          .indexOf(el) * 100;
        setTimeout(() => el.classList.add('visible'), delay);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
</script>
