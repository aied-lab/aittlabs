---
import Base from '../layouts/Base.astro';
---

<Base title="首頁">
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <div class="hero-content fade-up">
        <div class="hero-badge">
          <span class="dot"></span>
          2025.04.01 正式啟動
        </div>
        <h1>
          用 AI 重新定義<br>
          <span class="highlight">人才發展與組織轉型</span>
        </h1>
        <p>
          AI TalenTech Labs 致力於 AI 人才科技的研究與應用，透過自主研發的 AI 模擬教練系統與顧問方法論，協助政府機關與企業組織打造 AI 時代的核心競爭力。
        </p>
        <div class="hero-buttons">
          <a href="/products/" class="btn btn-primary">探索產品 →</a>
          <a href="/contact/" class="btn btn-outline">預約諮詢</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products Preview -->
  <section class="products-preview">
    <div class="container">
      <span class="section-label">Core Products</span>
      <h2 class="section-title">AI 模擬教練系列</h2>
      <p class="section-desc">以生成式 AI 驅動的高擬真模擬教練，讓每一次練習都像真實場景。</p>
      <div class="products-grid">
        <a href="/products/" class="card product-card">
          <span class="tag tag-product">AI Product</span>
          <h3>AI Interviewer</h3>
          <p>AI 面試官 — 模擬真實面試場景，提供即時回饋與評估報告，幫助求職者與 HR 提升面試品質。</p>
          <span class="card-link">了解更多 →</span>
        </a>
        <a href="/products/" class="card product-card">
          <span class="tag tag-product">AI Product</span>
          <h3>iCoach360</h3>
          <p>高擬真情境模擬教練 — 360度沉浸式情境模擬，培養主管的決策力、溝通力與領導力。</p>
          <span class="card-link">了解更多 →</span>
        </a>
        <a href="/products/" class="card product-card">
          <span class="tag tag-product">AI Product</span>
          <h3>PPTutor</h3>
          <p>簡報提案模擬教練 — AI 模擬審查委員，針對你的簡報內容即時提問與反饋，練出完美提案。</p>
          <span class="card-link">了解更多 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Services Overview -->
  <section class="services-overview">
    <div class="container">
      <div class="services-row">
        <a href="/institute/" class="card service-block">
          <span class="tag tag-institute">Training</span>
          <h3>AI 人才科技研訓院</h3>
          <p>系統化的 AI 人才培訓方案，涵蓋 AI 素養、AI 應用實戰、AI 領導力等課程，已為數千名政府及企業學員提供培訓。</p>
          <span class="card-link">瀏覽課程 →</span>
        </a>
        <a href="/consulting/" class="card service-block">
          <span class="tag tag-consulting">Consulting</span>
          <h3>AI 轉型顧問服務</h3>
          <p>運用 Systemaster 系統思考與 FlowMaster 流程優化方法論，為企業與政府機關量身打造 AI 轉型策略與落地方案。</p>
          <span class="card-link">了解服務 →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="clients-section">
    <div class="container">
      <span class="section-label">Trusted By</span>
      <h2 class="section-title">合作夥伴</h2>
      <div class="clients-grid">
        <div class="client-chip">行政院人事行政總處</div>
        <div class="client-chip">環境部</div>
        <div class="client-chip">勞動部</div>
        <div class="client-chip">工業技術研究院</div>
        <div class="client-chip">智園科技</div>
        <div class="client-chip">亞洲水泥</div>
        <div class="client-chip">CIO Taiwan</div>
      </div>
    </div>
  </section>

  <!-- Content Hub -->
  <section class="content-hub">
    <div class="container">
      <span class="section-label">Insights</span>
      <h2 class="section-title">內容專欄</h2>
      <div class="channels-grid">
        <a href="https://substack.com/@johnliontw" target="_blank" class="card channel-card">
          <div class="channel-icon-box">SS</div>
          <h4>Substack 電子報</h4>
          <p>AI 人才科技趨勢分析、產業洞察與策略思考，每週更新。</p>
        </a>
        <a href="https://www.youtube.com/@johnliontw" target="_blank" class="card channel-card">
          <div class="channel-icon-box">YT</div>
          <h4>YouTube 頻道</h4>
          <p>JohnLionTW | AI Investing — AI 驅動的投資分析與科技趨勢解讀。</p>
        </a>
        <a href="https://aitti.online" target="_blank" class="card channel-card">
          <div class="channel-icon-box">課</div>
          <h4>線上課程</h4>
          <p>AI 人才科技研訓院線上學習平台，實戰課程持續上架中。</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-box">
        <h2>準備好開啟 AI 轉型之旅？</h2>
        <p>無論是導入 AI 模擬教練、規劃人才培訓方案、或是啟動組織 AI 轉型策略，我們都能協助你找到最佳路徑。</p>
        <div class="cta-buttons">
          <a href="/contact/" class="btn btn-primary">預約免費諮詢 →</a>
          <a href="/products/" class="btn btn-outline">瀏覽產品</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding-top: 80px;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -40%;
    right: -20%;
    width: 700px;
    height: 700px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.07) 0%, transparent 70%);
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -30%;
    left: -15%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245, 158, 11, 0.05) 0%, transparent 70%);
  }
  .hero-content {
    max-width: 800px;
    position: relative;
    z-index: 1;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    background: var(--accent-glow);
    border: 1px solid rgba(59, 130, 246, 0.2);
    color: var(--accent-light);
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 2rem;
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--gold);
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  .hero p {
    font-size: 1.15rem;
    color: var(--text-dim);
    max-width: 600px;
    margin-bottom: 2.5rem;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .product-card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .product-card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    flex: 1;
  }
  .card-link {
    color: var(--accent-light);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .services-overview {
    background: var(--surface);
  }
  .services-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .service-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .service-block h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .service-block p {
    color: var(--text-dim);
    font-size: 0.92rem;
    flex: 1;
  }

  .clients-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .client-chip {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s;
  }
  .client-chip:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }

  .content-hub {
    background: var(--surface);
  }
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .channel-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .channel-icon-box {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    background: var(--accent-glow);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .channel-card h4 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .channel-card p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  .cta-box {
    background: linear-gradient(135deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 4rem;
    text-align: center;
  }
  .cta-box h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .cta-box p {
    color: var(--text-dim);
    max-width: 550px;
    margin: 0 auto 2rem;
  }
  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .products-grid,
    .services-row,
    .channels-grid {
      grid-template-columns: 1fr;
    }
    .cta-box { padding: 2.5rem 1.5rem; }
  }
</style>
