---
import Base from '../../layouts/Base.astro';
import { getSortedIssues } from '../../data/curation';

const issues = getSortedIssues();

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('zh-TW', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}

function formatCoverDate(dateStr: string) {
  const d = new Date(dateStr);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}.${m}.${day}`;
}
---

<Base
  title="學習策展"
  description="廖肇弘博士每期精選 AI 學習主題，策展 YouTube 演講與課程資源，幫助讀者建構完整的 AI 知識體系。"
>
  <section class="page-hero">
    <div class="container">
      <span class="section-label animate-on-scroll">Learning Curation</span>
      <h1 class="animate-on-scroll">學習策展</h1>
      <p class="animate-on-scroll">每期精選一個 AI 主題，策展全球頂尖演講與學習資源，幫助你建構完整知識體系。</p>
    </div>
  </section>

  <section class="curation-section">
    <div class="container">
      {issues.length === 0 ? (
        <div class="empty-state">
          <p>策展內容陸續上線中，敬請期待。</p>
        </div>
      ) : (
        <div class="curation-grid">
          {issues.map((issue) => (
            <a
              href={`/curation/${issue.slug}/`}
              class="card curation-card animate-on-scroll"
              style={issue.cover ? `--card-cover: url('${issue.cover}')` : ''}
            >
              <div class={`curation-cover ${issue.cover ? 'has-image' : 'is-gradient'}`}>
                {issue.cover ? (
                  <img src={issue.cover} alt={issue.title} loading="lazy" />
                ) : (
                  <div class="cover-art">
                    <span class="cover-period">{issue.label ?? formatCoverDate(issue.date)}</span>
                    <span class="cover-title">{issue.title}</span>
                  </div>
                )}
                {issue.gated && <span class="gated-badge">會員解鎖</span>}
              </div>

              <div class="curation-body">
                <div class="curation-meta">
                  {issue.label && <span class="period-tag">{issue.label}</span>}
                  <span class="curation-date">{formatDate(issue.date)}</span>
                </div>
                <h3>{issue.title}</h3>
                {issue.subtitle && <p class="curation-subtitle">{issue.subtitle}</p>}
                <p class="curation-summary">{issue.summary}</p>

                <div class="curation-stats">
                  {issue.episodeCount !== undefined && (
                    <span class="stat-item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                      {issue.episodeCount} 部影片
                    </span>
                  )}
                  {issue.duration && (
                    <span class="stat-item">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                      {issue.duration}
                    </span>
                  )}
                </div>

                {issue.topics.length > 0 && (
                  <div class="topic-tags">
                    {issue.topics.map((t) => <span class="topic-tag">#{t}</span>)}
                  </div>
                )}

                <span class="read-more">
                  進入策展
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                    <path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Base>

<style>
  .curation-section {
    padding-top: 0;
  }

  .curation-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.75rem;
  }

  .curation-card {
    display: flex;
    flex-direction: column;
    padding: 0;
    overflow: hidden;
    transition: all var(--transition);
  }

  /* Cover */
  .curation-cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .curation-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s;
  }
  .curation-card:hover .curation-cover img { transform: scale(1.05); }

  .curation-cover.is-gradient {
    background:
      radial-gradient(circle at 20% 30%, rgba(139, 92, 246, 0.55) 0%, transparent 60%),
      radial-gradient(circle at 80% 70%, rgba(59, 130, 246, 0.45) 0%, transparent 55%),
      linear-gradient(135deg, #1e2742 0%, #0a0e1a 100%);
  }
  .cover-art {
    position: absolute;
    inset: 0;
    padding: 1.5rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    color: #fff;
  }
  .cover-period {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.85;
  }
  .cover-title {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.3;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.4);
  }

  .gated-badge {
    position: absolute;
    top: 0.85rem;
    right: 0.85rem;
    background: rgba(11, 17, 32, 0.85);
    backdrop-filter: blur(8px);
    color: var(--gold-light, #fcd34d);
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.3rem 0.7rem;
    border-radius: 50px;
    border: 1px solid rgba(252, 211, 77, 0.35);
    letter-spacing: 0.02em;
  }

  /* Body */
  .curation-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 1.5rem 1.75rem;
    flex: 1;
  }

  .curation-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .period-tag {
    display: inline-block;
    padding: 0.2rem 0.65rem;
    border-radius: 50px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: rgba(139, 92, 246, 0.15);
    color: #c4b5fd;
  }
  .curation-date {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .curation-card h3 {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .curation-subtitle {
    color: var(--accent-light);
    font-size: 0.85rem;
    font-weight: 500;
    margin-top: -0.25rem;
  }

  .curation-summary {
    color: var(--text-dim);
    font-size: 0.88rem;
    line-height: 1.7;
    flex: 1;
  }

  .curation-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    padding-top: 0.25rem;
  }
  .stat-item {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .topic-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .topic-tag {
    font-size: 0.72rem;
    color: var(--text-muted);
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 50px;
  }

  .read-more {
    color: var(--accent-light);
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.3s;
    margin-top: 0.25rem;
  }
  .curation-card:hover .read-more {
    gap: 0.6rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .curation-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const delay = Array.from(el.parentElement?.children ?? [])
          .filter(c => c.classList.contains('animate-on-scroll'))
          .indexOf(el) * 100;
        setTimeout(() => el.classList.add('visible'), Math.min(delay, 500));
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
  document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
</script>
