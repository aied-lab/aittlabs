---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const papers = (await getCollection('research')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);

const typeLabels: Record<string, string> = {
  'working-paper': 'Working Paper',
  method: 'Method',
};
---

<Base title="研究" description="AI TalenTech Labs 研究報告與方法論 — AI 人才發展策略、能力鑑定體系與系統動力學研究。">
  <div class="paper-index">
    <section class="index-hero">
      <div class="container">
        <span class="index-label">Research</span>
        <h1>研究</h1>
        <p>研究報告與方法論 — AI 人才發展策略、能力鑑定體系與產業洞察</p>
      </div>
    </section>

    <section class="index-list-section">
      <div class="container">
        <div class="papers-list">
          {papers.map(paper => (
            <a href={`/research/${paper.id}/`} class="paper-card">
              <div class="pills">
                <span class="pill">{paper.data.id}</span>
                <span class="pill g">{typeLabels[paper.data.type] ?? paper.data.type}</span>
                {paper.data.status === 'draft'
                  ? <span class="pill d">DRAFT v{paper.data.version}</span>
                  : <span class="pill">v{paper.data.version}</span>}
                <span class="paper-date">{paper.data.published.toISOString().slice(0, 10)}</span>
              </div>
              <h3>{paper.data.title}</h3>
              {paper.data.subtitle && <p class="paper-subtitle">{paper.data.subtitle}</p>}
              {paper.data.title_en && <p class="paper-title-en">{paper.data.title_en}</p>}
              {paper.data.keywords_zh.length > 0 && (
                <div class="paper-keywords">
                  {paper.data.keywords_zh.map(kw => <span class="keyword">{kw}</span>)}
                </div>
              )}
              <span class="read-more">閱讀全文 →</span>
            </a>
          ))}
        </div>

        {papers.length === 0 && (
          <div class="empty-state">
            <p>研究報告即將發布，敬請期待。</p>
          </div>
        )}
      </div>
    </section>
  </div>
</Base>

<style>
  /* ===== Paper palette (matches PDF / preview-v0.8) ===== */
  .paper-index {
    --ink: #10233A;
    --soft: #3C4E66;
    --acc: #0F6E6E;
    --acc2: #C2703A;
    --rule: #E4E9EF;
    --pbg: #F7F9FB;
    background: #ffffff;
    color: var(--ink);
  }

  .index-hero {
    padding: 8rem 0 3rem;
    border-bottom: 1px solid var(--rule);
  }
  .index-hero .container,
  .index-list-section .container {
    max-width: 808px;
  }
  .index-label {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--acc);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .index-hero h1 {
    font-size: clamp(28px, 3.5vw, 36px);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin: 0.5rem 0 0.75rem;
    color: var(--ink);
  }
  .index-hero p {
    color: var(--soft);
    font-size: 1.05rem;
  }

  .index-list-section {
    padding: 3rem 0 6rem;
  }

  .papers-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .paper-card {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 1.75rem 2rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .paper-card:hover {
    border-color: var(--acc);
    box-shadow: 0 4px 20px rgba(16, 35, 58, 0.06);
  }

  .pills {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    align-items: center;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    background: var(--acc);
    color: #fff;
    padding: 3px 10px;
    border-radius: 2px;
  }
  .pill.g {
    background: var(--pbg);
    color: var(--soft);
    border: 1px solid var(--rule);
  }
  .pill.d {
    background: var(--acc2);
    color: #fff;
  }
  .paper-date {
    font-size: 12.5px;
    color: #9AA6B4;
    margin-left: 4px;
  }

  .paper-card h3 {
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.45;
    color: var(--ink);
    margin-top: 0.25rem;
  }
  .paper-subtitle {
    color: var(--soft);
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .paper-title-en {
    color: #9AA6B4;
    font-size: 0.85rem;
    font-style: italic;
  }

  .paper-keywords {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }
  .keyword {
    padding: 2px 10px;
    border-radius: 2px;
    font-size: 12px;
    color: var(--soft);
    background: var(--pbg);
    border: 1px solid var(--rule);
  }

  .read-more {
    color: var(--acc);
    font-size: 0.88rem;
    font-weight: 600;
    margin-top: 0.35rem;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 0;
    color: var(--soft);
  }

  @media (max-width: 768px) {
    .index-hero {
      padding: 6.5rem 0 2.5rem;
    }
    .paper-card {
      padding: 1.4rem 1.4rem;
    }
  }
</style>
