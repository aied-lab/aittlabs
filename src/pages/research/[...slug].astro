---
import Base from '../../layouts/Base.astro';
import CitationBlock from '../../components/CitationBlock.astro';
import VersionHistory from '../../components/VersionHistory.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const papers = await getCollection('research');
  return papers.map(paper => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
const data = paper.data;

const typeLabels: Record<string, string> = {
  'working-paper': 'Working Paper',
  method: 'Method',
};

function formatDate(date: Date) {
  return date.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base title={data.title} description={`${data.title}${data.subtitle ? `：${data.subtitle}` : ''} — AI TalenTech Labs 研究報告 ${data.id}`}>
  <article class="paper">
    <header class="paper-header">
      <div class="container">
        <div class="paper-meta animate-on-scroll">
          <span class="paper-id">{data.id}</span>
          <span class="tag tag-product">{typeLabels[data.type] ?? data.type}</span>
          <span class:list={['tag', data.status === 'draft' ? 'tag-draft' : 'tag-published']}>
            v{data.version}{data.status === 'draft' ? '（草稿）' : ''}
          </span>
        </div>
        <h1>{data.title}</h1>
        {data.subtitle && <p class="paper-subtitle">{data.subtitle}</p>}
        {data.title_en && (
          <p class="paper-title-en">
            {data.title_en}{data.subtitle_en ? `: ${data.subtitle_en}` : ''}
          </p>
        )}

        <div class="paper-byline">
          {data.authors.map(author => (
            <span class="author">
              {author.name}
              {author.name_en && <span class="author-en">（{author.name_en}）</span>}
              {author.orcid && (
                <a href={`https://orcid.org/${author.orcid}`} target="_blank" rel="noopener noreferrer" class="orcid-link">
                  ORCID
                </a>
              )}
            </span>
          ))}
          <span class="divider">·</span>
          <span class="paper-date">{formatDate(data.published)}</span>
          <span class="divider">·</span>
          <span class="paper-license">{data.license}</span>
          {data.doi && (
            <>
              <span class="divider">·</span>
              <a href={`https://doi.org/${data.doi}`} target="_blank" rel="noopener noreferrer" class="doi-link">
                DOI: {data.doi}
              </a>
            </>
          )}
        </div>

        {data.keywords_zh.length > 0 && (
          <div class="paper-keywords">
            {data.keywords_zh.map(kw => <span class="keyword">{kw}</span>)}
          </div>
        )}

        {data.pdf && (
          <div class="paper-actions">
            <a href={data.pdf} class="btn btn-outline" target="_blank" rel="noopener noreferrer">
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                <path d="M8 1v10m0 0L4 7m4 4l4-4M2 14h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              下載 PDF
            </a>
          </div>
        )}
      </div>
    </header>

    <div class="paper-body">
      <div class="container">
        <div class="prose">
          <Content />
        </div>

        <VersionHistory entries={data.changelog} current={data.version} />

        <CitationBlock
          id={data.id}
          title={data.title}
          subtitle={data.subtitle}
          title_en={data.title_en}
          subtitle_en={data.subtitle_en}
          version={data.version}
          published={data.published}
          authors={data.authors}
          doi={data.doi}
          slug={paper.id}
        />

        <div class="back-link">
          <a href="/research/">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
              <path d="M13 8H3m0 0l4 4M3 8l4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            返回研究列表
          </a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .paper-header {
    padding: 8rem 0 3rem;
    border-bottom: 1px solid var(--border);
  }
  .paper-header .container,
  .paper-body .container {
    max-width: 800px;
  }

  .paper-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .paper-id {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .tag-draft {
    background: rgba(245, 158, 11, 0.12);
    color: var(--gold);
  }
  .tag-published {
    background: rgba(20, 184, 166, 0.12);
    color: var(--teal);
  }

  .paper-header h1 {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 3.5vw, 2.4rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }
  .paper-subtitle {
    color: var(--text-dim);
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }
  .paper-title-en {
    color: var(--text-muted);
    font-size: 0.95rem;
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .paper-byline {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.9rem;
    color: var(--text-dim);
    margin-bottom: 1rem;
  }
  .author {
    font-weight: 500;
    color: var(--text);
  }
  .author-en {
    color: var(--text-dim);
    font-weight: 400;
  }
  .orcid-link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--teal);
    border: 1px solid rgba(20, 184, 166, 0.3);
    border-radius: 50px;
    padding: 0.05rem 0.5rem;
    margin-left: 0.4rem;
    transition: all 0.3s;
  }
  .orcid-link:hover {
    background: rgba(20, 184, 166, 0.12);
  }
  .divider {
    color: var(--text-muted);
  }
  .doi-link {
    color: var(--accent-light);
  }

  .paper-keywords {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .keyword {
    padding: 0.2rem 0.7rem;
    border-radius: 50px;
    font-size: 0.75rem;
    color: var(--text-dim);
    border: 1px solid var(--border-hover);
  }

  .paper-actions {
    display: flex;
    gap: 0.75rem;
  }
  .paper-actions .btn {
    padding: 0.6rem 1.5rem;
    font-size: 0.9rem;
  }

  .paper-body {
    padding: 3rem 0 6rem;
  }

  /* ===== Rendered markdown ===== */
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    margin: 3rem 0 1.25rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }
  .prose :global(h3) {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.4;
    margin: 2.25rem 0 1rem;
  }
  .prose :global(p) {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.95;
    margin-bottom: 1.25rem;
  }
  .prose :global(strong) {
    color: var(--text);
    font-weight: 700;
  }
  .prose :global(a) {
    color: var(--accent-light);
    word-break: break-all;
  }
  .prose :global(a:hover) {
    text-decoration: underline;
  }
  .prose :global(ul),
  .prose :global(ol) {
    color: var(--text-dim);
    line-height: 1.9;
    margin: 0 0 1.25rem 1.5rem;
  }
  .prose :global(li) {
    margin-bottom: 0.5rem;
  }
  .prose :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 1.5rem 0;
    color: var(--text-dim);
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }
  .prose :global(img) {
    background: #fcfcfb;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    padding: 0.75rem;
    margin: 1.75rem auto;
    width: 100%;
    height: auto;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.9rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border: 1px solid var(--border-hover);
    padding: 0.6rem 0.9rem;
    text-align: left;
    line-height: 1.7;
    color: var(--text-dim);
    min-width: 90px;
  }
  .prose :global(th) {
    background: var(--surface-2);
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--surface-2);
    border-radius: 4px;
    padding: 0.15em 0.4em;
  }
  .prose :global(pre) {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .back-link {
    margin-top: 3.5rem;
  }
  .back-link a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-dim);
    font-size: 0.9rem;
    font-weight: 500;
    transition: color 0.3s;
  }
  .back-link a:hover {
    color: var(--accent-light);
  }

  @media (max-width: 768px) {
    .paper-header {
      padding: 6rem 0 2.5rem;
    }
    .paper-body {
      padding: 2.5rem 0 4rem;
    }
  }
</style>
