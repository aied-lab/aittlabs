---
import Base from '../../layouts/Base.astro';
import CitationBlock from '../../components/CitationBlock.astro';
import VersionHistory from '../../components/VersionHistory.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const papers = await getCollection('research');
  return papers.map(paper => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}

const { paper } = Astro.props;
const { Content } = await render(paper);
const data = paper.data;

const typeLabels: Record<string, string> = {
  'working-paper': 'Working Paper',
  method: 'Method',
};

const methodLabels: Record<string, string> = {
  'secondary-data-analysis': '次級資料分析',
  'system-dynamics': '系統動力學',
};
const methodText = data.methods.map(m => methodLabels[m] ?? m).join(' · ');
---

<Base title={data.title} description={`${data.title}${data.subtitle ? `：${data.subtitle}` : ''} — AI TalenTech Labs 研究報告 ${data.id}`}>
  <article class="paper">
    <header class="paper-header">
      <div class="container">
        <div class="crumb"><a href="/research/">研究</a>　/　{data.id}</div>
        <div class="pills">
          <span class="pill">{data.id}</span>
          <span class="pill g">{typeLabels[data.type] ?? data.type}</span>
          {data.status === 'draft'
            ? <span class="pill d">DRAFT v{data.version}</span>
            : <span class="pill">v{data.version}</span>}
        </div>
        <h1>{data.title}</h1>
        {data.subtitle && <p class="paper-subtitle">{data.subtitle}</p>}
        {data.title_en && (
          <p class="paper-title-en">
            {data.title_en}{data.subtitle_en ? `: ${data.subtitle_en}` : ''}
          </p>
        )}

        <div class="paper-byline">
          {data.authors.map(author => (
            <span class="author">
              {author.name}
              {author.orcid && (
                <>　<a href={`https://orcid.org/${author.orcid}`} target="_blank" rel="noopener noreferrer">ORCID {author.orcid}</a></>
              )}
            </span>
          ))}
          <span>{data.published.toISOString().slice(0, 10)}</span>
          {methodText && <span>方法：{methodText}</span>}
          <span>{data.license}</span>
          {data.doi && (
            <a href={`https://doi.org/${data.doi}`} target="_blank" rel="noopener noreferrer">DOI: {data.doi}</a>
          )}
        </div>

        {data.keywords_zh.length > 0 && (
          <div class="paper-keywords">
            {data.keywords_zh.map(kw => <span class="keyword">{kw}</span>)}
          </div>
        )}

        <div class="paper-actions">
          {data.pdf && <a href={data.pdf} class="pbtn solid" target="_blank" rel="noopener noreferrer">↓ 下載 PDF</a>}
          <a href="#citation" class="pbtn">引用本文</a>
        </div>
      </div>
    </header>

    <div class="paper-body">
      <div class="container">
        <div class="prose">
          <Content />
        </div>

        <VersionHistory entries={data.changelog} current={data.version} />

        <div id="citation">
          <CitationBlock
            id={data.id}
            title={data.title}
            subtitle={data.subtitle}
            title_en={data.title_en}
            subtitle_en={data.subtitle_en}
            version={data.version}
            published={data.published}
            authors={data.authors}
            doi={data.doi}
            slug={paper.id}
          />
        </div>

        <div class="back-link">
          <a href="/research/">← 返回研究列表</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  /* ===== Paper palette (matches PDF / preview-v0.8) ===== */
  .paper {
    --ink: #10233A;
    --soft: #3C4E66;
    --acc: #0F6E6E;
    --acc2: #C2703A;
    --rule: #E4E9EF;
    --pbg: #F7F9FB;
    --page: #ffffff;
    background: var(--page);
    color: var(--ink);
  }

  .paper-header .container,
  .paper-body .container {
    max-width: 808px;
  }

  .paper-header {
    padding: 7.5rem 0 2rem;
    border-bottom: 1px solid var(--rule);
  }

  .crumb {
    font-size: 12px;
    color: #9AA6B4;
    letter-spacing: 0.08em;
    margin-bottom: 16px;
  }
  .crumb a {
    color: inherit;
  }
  .crumb a:hover {
    color: var(--acc);
  }

  .pills {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 16px;
  }
  .pill {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.07em;
    background: var(--acc);
    color: #fff;
    padding: 3px 10px;
    border-radius: 2px;
  }
  .pill.g {
    background: var(--pbg);
    color: var(--soft);
    border: 1px solid var(--rule);
  }
  .pill.d {
    background: var(--acc2);
    color: #fff;
  }

  .paper-header h1 {
    font-size: clamp(26px, 3.2vw, 33px);
    line-height: 1.4;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .paper-subtitle {
    font-size: 18px;
    color: var(--soft);
    margin-top: 10px;
  }
  .paper-title-en {
    font-size: 14px;
    color: #9AA6B4;
    font-style: italic;
    margin-top: 6px;
  }

  .paper-byline {
    margin-top: 20px;
    font-size: 13.5px;
    color: var(--soft);
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .paper-byline a {
    color: var(--acc);
  }
  .paper-byline a:hover {
    text-decoration: underline;
  }

  .paper-keywords {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: 16px;
  }
  .keyword {
    padding: 2px 10px;
    border-radius: 2px;
    font-size: 12px;
    color: var(--soft);
    background: var(--pbg);
    border: 1px solid var(--rule);
  }

  .paper-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 24px;
  }
  .pbtn {
    font-size: 13.5px;
    font-weight: 600;
    padding: 10px 18px;
    border-radius: 3px;
    border: 1.5px solid var(--ink);
    color: var(--ink);
    transition: opacity 0.2s;
  }
  .pbtn:hover {
    opacity: 0.75;
  }
  .pbtn.solid {
    background: var(--ink);
    color: var(--page);
  }

  .paper-body {
    padding: 2.25rem 0 5rem;
  }

  /* ===== Rendered markdown — PDF typography ===== */
  .prose {
    font-size: 16.5px;
    line-height: 1.95;
    color: var(--ink);
  }
  .prose :global(h2) {
    font-size: 22px;
    font-weight: 800;
    margin: 52px 0 16px;
    padding-bottom: 9px;
    border-bottom: 1px solid var(--rule);
    line-height: 1.45;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3) {
    font-size: 17px;
    font-weight: 700;
    margin: 34px 0 12px;
  }
  .prose :global(h3)::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 15px;
    background: var(--acc2);
    margin-right: 8px;
    vertical-align: -1px;
  }
  .prose :global(p) {
    margin-bottom: 17px;
    color: var(--ink);
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(a) {
    color: var(--acc);
    word-break: break-all;
  }
  .prose :global(a:hover) {
    text-decoration: underline;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 18px 22px;
  }
  .prose :global(li) {
    margin-bottom: 8px;
  }
  .prose :global(blockquote) {
    background: var(--pbg);
    border-left: 3px solid var(--acc2);
    padding: 16px 20px;
    margin: 22px 0;
    font-size: 14.5px;
  }
  .prose :global(blockquote p) {
    margin: 0;
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 44px 0;
  }
  .prose :global(img) {
    background: #fff;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 22px 18px;
    margin: 26px auto;
    width: 100%;
    height: auto;
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 14px;
  }
  .prose :global(th) {
    background: var(--ink);
    color: #fff;
    text-align: left;
    padding: 10px 12px;
    font-weight: 500;
    font-size: 13px;
    white-space: nowrap;
  }
  .prose :global(td) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
    line-height: 1.7;
    min-width: 90px;
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--pbg);
    border-radius: 3px;
    padding: 0.15em 0.4em;
  }
  .prose :global(pre) {
    background: var(--pbg);
    padding: 16px 18px;
    border-radius: 3px;
    overflow-x: auto;
    font-size: 12.5px;
    line-height: 1.8;
    margin: 22px 0;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }

  .back-link {
    margin-top: 3rem;
  }
  .back-link a {
    color: var(--soft);
    font-size: 14px;
    font-weight: 500;
  }
  .back-link a:hover {
    color: var(--acc);
  }

  @media (max-width: 768px) {
    .paper-header {
      padding: 6rem 0 1.75rem;
    }
    .prose {
      font-size: 16px;
    }
  }
</style>
