---
import Base from '../../layouts/Base.astro';
---

<Base title="Home">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-banner-section">
      <img src="/images/aittlabs_banner.jpg" alt="AI TalenTech Labs" class="hero-banner" loading="eager" />
      <div class="hero-overlay"></div>
      <div class="hero-title container">
        <h1 class="animate-on-scroll hero-slogan">
          <span class="slogan-line">Accelerate <span class="highlight">AI talent</span> with AI</span>
          <span class="slogan-x" aria-hidden="true">×</span>
          <span class="slogan-line">Accelerate AI innovation with <span class="highlight">AI talent</span></span>
        </h1>
      </div>
    </div>
    <div class="hero-body">
      <div class="container">
        <p class="hero-subtitle animate-on-scroll">AI TalenTech Labs</p>
        <div class="hero-tagline animate-on-scroll">
          <span class="tagline-rule left" aria-hidden="true"></span>
          <span class="tagline-text">AI TalenTech&nbsp;&nbsp;|&nbsp;&nbsp;EdTech&nbsp;&nbsp;|&nbsp;&nbsp;Innovation&nbsp;&nbsp;|&nbsp;&nbsp;Transformation</span>
          <span class="tagline-rule right" aria-hidden="true"></span>
        </div>
        <div class="hero-buttons animate-on-scroll">
          <a href="/en/products/" class="btn btn-primary">
            <span>Explore Products</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a href="/en/contact/" class="btn btn-outline">Book a Consultation</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Products & Services -->
  <section class="services-overview">
    <div class="container">
      <span class="section-label animate-on-scroll">Products &amp; Services</span>
      <h2 class="section-title animate-on-scroll">What We Do</h2>
      <div class="services-row">
        <a href="/en/institute/" class="card service-block animate-on-scroll">
          <div class="service-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c0 1.66 2.69 3 6 3s6-1.34 6-3v-5"/></svg>
          </div>
          <span class="tag tag-institute">Training</span>
          <h3>AI TalenTech Institute</h3>
          <p>Structured AI talent development programs spanning AI literacy, applied AI, and AI leadership — already serving thousands of government officials and enterprise professionals.</p>
          <span class="card-link">Browse Courses <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a href="/en/products/" class="card service-block animate-on-scroll">
          <div class="service-icon icon-coral">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
          </div>
          <span class="tag tag-product">R&amp;D</span>
          <h3>AI TalenTech R&amp;D</h3>
          <p>Proprietary AI simulation coach systems — including AI Interviewer, iCoach360, and PPTutor — powered by generative AI to deliver high-fidelity, scenario-based training.</p>
          <span class="card-link">Explore Products <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
        <a href="/en/consulting/" class="card service-block animate-on-scroll">
          <div class="service-icon icon-gold">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
          </div>
          <span class="tag tag-consulting">Consulting</span>
          <h3>AI TalenTech Consulting</h3>
          <p>Tailored AI transformation strategy and execution roadmaps for enterprises and government agencies — powered by our Systemaster (systems thinking) and FlowMaster (process optimization) methodologies.</p>
          <span class="card-link">Learn More <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><path d="M3 8h10m0 0L9 4m4 4L9 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </a>
      </div>
    </div>
  </section>

  <!-- Clients -->
  <section class="clients-section">
    <div class="container">
      <span class="section-label animate-on-scroll">Track Record</span>
      <h2 class="section-title animate-on-scroll">Trusted by Leading Organizations</h2>
      <div class="clients-grid animate-on-scroll">
        <div class="client-chip">DGPA, Executive Yuan</div>
        <div class="client-chip">National Development Council</div>
        <div class="client-chip">Ministry of Digital Affairs</div>
        <div class="client-chip">Ministry of Economic Affairs</div>
        <div class="client-chip">Ministry of Education</div>
        <div class="client-chip">Ministry of Environment</div>
        <div class="client-chip">Ministry of Labor</div>
        <div class="client-chip">Atomic Energy Council</div>
        <div class="client-chip">Financial Supervisory Commission</div>
        <div class="client-chip">National Immigration Agency</div>
        <div class="client-chip">Taipei City Government</div>
        <div class="client-chip">ITRI</div>
        <div class="client-chip">National Tsing Hua University</div>
        <div class="client-chip">Chinese Culture University</div>
        <div class="client-chip">Microsoft</div>
        <div class="client-chip">IBM</div>
        <div class="client-chip">PwC</div>
        <div class="client-chip">Wise Garden Corp</div>
        <div class="client-chip">Far Eastern Group</div>
        <div class="client-chip">CIO Taiwan</div>
      </div>
    </div>
  </section>

  <!-- Content Hub -->
  <section class="content-hub">
    <div class="container">
      <span class="section-label animate-on-scroll">Insights</span>
      <h2 class="section-title animate-on-scroll">Stay Connected</h2>
      <div class="channels-grid">
        <a href="https://aiedlab.substack.com" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M22.539 8.242H1.46V5.406h21.08v2.836zM1.46 10.812V24L12 18.11 22.54 24V10.812H1.46zM22.54 0H1.46v2.836h21.08V0z"/></svg>
          </div>
          <h4>Substack Newsletter</h4>
          <p>Weekly analysis of AI talent technology trends, industry insights, and strategic thinking.</p>
        </a>
        <a href="https://www.youtube.com/@ai-talentech-labs" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-red">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </div>
          <h4>YouTube Channel</h4>
          <p>AI talent technology trends, product demos, and course highlights from AI TalenTech Labs.</p>
        </a>
        <a href="https://www.facebook.com/ai.talentech.labs" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-fb">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </div>
          <h4>Facebook Page</h4>
          <p>Latest news from AI TalenTech Labs — events, updates, and industry perspectives.</p>
        </a>
        <a href="https://aitti.online" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-teal">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <h4>Online Courses</h4>
          <p>Online learning platform of AI TalenTech Institute — new applied courses launching regularly.</p>
        </a>
        <a href="https://www.patreon.com/c/ai_talentech_labs" target="_blank" class="card channel-card animate-on-scroll">
          <div class="channel-icon-box icon-patreon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M14.82 2.41c3.96 0 7.18 3.24 7.18 7.21 0 3.96-3.22 7.18-7.18 7.18-3.97 0-7.21-3.22-7.21-7.18 0-3.97 3.24-7.21 7.21-7.21M2 21.6h3.5V2.41H2V21.6z"/></svg>
          </div>
          <h4>Patreon Membership</h4>
          <p>Join AI TalenTech Labs as a member for exclusive content and in-depth analysis.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-box animate-on-scroll">
        <div class="cta-glow"></div>
        <h2>Ready to start your AI transformation journey?</h2>
        <p>Whether you're deploying AI simulation coaches, designing talent development programs, or launching an organization-wide AI transformation strategy — we can help you find the optimal path forward.</p>
        <div class="cta-buttons">
          <a href="/en/contact/" class="btn btn-primary">Book a free consultation →</a>
          <a href="/en/products/" class="btn btn-outline">Browse Products</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ===== Hero ===== */
  .hero {
    padding: 0;
  }
  .hero-banner-section {
    position: relative;
    margin-top: 64px;
    overflow: hidden;
  }
  .hero-banner {
    width: 100%;
    height: auto;
    display: block;
  }
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(11, 17, 32, 1) 0%,
      rgba(11, 17, 32, 0.85) 25%,
      rgba(11, 17, 32, 0.2) 60%,
      transparent 100%
    );
  }
  .hero-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1;
    padding-bottom: 2rem;
    text-align: center;
  }
  .hero-title h1 {
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.5);
  }
  .hero-body {
    padding: 2.5rem 0 3rem;
    text-align: center;
  }
  .hero-subtitle {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }
  .hero-tagline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 1rem;
    color: var(--text-dim);
    margin-bottom: 2.5rem;
    letter-spacing: 0.05em;
  }
  .tagline-text {
    flex: 0 0 auto;
    white-space: nowrap;
    font-weight: 500;
  }
  .tagline-rule {
    flex: 1 1 auto;
    height: 1px;
    max-width: 120px;
    background: var(--gold);
    position: relative;
    opacity: 0.85;
  }
  .tagline-rule.left::before,
  .tagline-rule.right::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold);
    transform: translateY(-50%);
  }
  .tagline-rule.left::before { left: 0; transform: translate(-50%, -50%); }
  .tagline-rule.right::after { right: 0; transform: translate(50%, -50%); }
  @media (max-width: 768px) {
    .hero-tagline {
      gap: 0.6rem;
      font-size: 0.85rem;
    }
    .tagline-text { white-space: normal; text-align: center; }
    .tagline-rule { max-width: 30px; }
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5.5vw, 4.2rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  h1.hero-slogan {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    font-size: clamp(1.5rem, 2.6vw, 2.2rem);
    line-height: 1.3;
  }
  .slogan-line {
    display: inline-block;
    text-wrap: balance;
    max-width: 100%;
  }
  @media (min-width: 768px) {
    .slogan-line {
      white-space: nowrap;
    }
  }
  .slogan-x {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 4.8vw, 3.6rem);
    font-weight: 700;
    line-height: 1;
    margin: 0.25rem 0;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }


  /* ===== Products ===== */
  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .product-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
    overflow: hidden;
  }
  .card-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity: 0;
    transition: opacity 0.3s;
  }
  .product-card:hover .card-glow {
    opacity: 1;
  }
  .product-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: var(--accent-glow);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .product-icon.icon-teal {
    background: rgba(20, 184, 166, 0.12);
    color: var(--teal);
  }
  .product-icon.icon-gold {
    background: rgba(245, 158, 11, 0.12);
    color: var(--gold);
  }
  .product-card h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .product-card p {
    color: var(--text-dim);
    font-size: 0.92rem;
    flex: 1;
    line-height: 1.7;
  }
  .card-link {
    color: var(--accent-light);
    font-size: 0.85rem;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: gap 0.3s;
  }
  .product-card:hover .card-link,
  .service-block:hover .card-link {
    gap: 0.6rem;
  }

  /* ===== Services ===== */
  .services-overview {
    background: var(--surface);
  }
  .services-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .service-icon.icon-coral {
    background: rgba(249, 115, 22, 0.1);
    color: var(--coral);
  }
  .service-block {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .service-icon {
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background: rgba(20, 184, 166, 0.1);
    color: var(--teal);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .service-icon.icon-gold {
    background: rgba(245, 158, 11, 0.1);
    color: var(--gold);
  }
  .service-block h3 {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
  }
  .service-block p {
    color: var(--text-dim);
    font-size: 0.92rem;
    flex: 1;
    line-height: 1.7;
  }

  /* ===== Clients ===== */
  .clients-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
  .client-chip {
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text-dim);
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.3s;
  }
  .client-chip:hover {
    border-color: var(--accent);
    color: var(--accent-light);
  }

  /* ===== Content Hub ===== */
  .content-hub {
    background: var(--surface);
  }
  .channels-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.25rem;
  }
  .channel-icon-box.icon-fb {
    background: rgba(66, 103, 178, 0.12);
    color: #4267B2;
  }
  .channel-icon-box.icon-patreon {
    background: rgba(255, 66, 77, 0.12);
    color: #FF424D;
  }
  .channel-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .channel-icon-box {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-sm);
    background: var(--accent-glow);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .channel-icon-box.icon-red {
    background: rgba(239, 68, 68, 0.12);
    color: #EF4444;
  }
  .channel-icon-box.icon-teal {
    background: rgba(20, 184, 166, 0.12);
    color: var(--teal);
  }
  .channel-card h4 {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
  }
  .channel-card p {
    color: var(--text-muted);
    font-size: 0.85rem;
  }

  /* ===== CTA ===== */
  .cta-box {
    position: relative;
    overflow: hidden;
    background: linear-gradient(135deg, var(--surface-2), var(--surface));
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 4rem;
    text-align: center;
  }
  .cta-glow {
    position: absolute;
    top: -50%;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.08), transparent 70%);
    pointer-events: none;
  }
  .cta-box h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    margin-bottom: 1rem;
    position: relative;
  }
  .cta-box p {
    color: var(--text-dim);
    max-width: 620px;
    margin: 0 auto 2rem;
    position: relative;
  }
  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    position: relative;
  }

  /* ===== Scroll Animation ===== */
  .animate-on-scroll {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .animate-on-scroll.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .products-grid,
    .services-row,
    .channels-grid {
      grid-template-columns: 1fr !important;
    }
    .cta-box { padding: 2.5rem 1.5rem; }
  }
</style>

<script>
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry, index) => {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const delay = Array.from(el.parentElement?.children ?? [])
          .filter(c => c.classList.contains('animate-on-scroll'))
          .indexOf(el) * 100;
        setTimeout(() => el.classList.add('visible'), delay);
        observer.unobserve(el);
      }
    });
  }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

  document.querySelectorAll('.animate-on-scroll').forEach(el => observer.observe(el));
</script>
