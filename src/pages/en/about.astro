  .about-tabs-inner::-webkit-scrollbar { display: none; }
  .about-tab {
    flex: 0 0 auto;
    position: relative;
    padding: 1.05rem 1.25rem;
    color: var(--text-dim);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color 0.25s ease;
    white-space: nowrap;
  }
  .about-tab::after {
    content: '';
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 0;
    height: 2px;
    background: linear-gradient(135deg, var(--gold), var(--gold-light));
    border-radius: 2px;
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.3s ease;
  }
  .about-tab:hover { color: var(--text); }
  .about-tab.active {
    color: var(--gold-light);
  }
  .about-tab.active::after {
    transform: scaleX(1);
  }

  #founder, #advisory-board, #advisors {
    scroll-margin-top: 130px;
  }

  @media (max-width: 768px) {
    .about-tabs { top: 64px; }
    .about-tab {
      padding: 0.85rem 0.9rem;
      font-size: 0.9rem;
    }
    .about-tab::after { left: 0.9rem; right: 0.9rem; }
    #founder, #advisory-board, #advisors {
      scroll-margin-top: 116px;
    }
  }
</style>

<script>
  (() => {
    const grids = document.querySelectorAll('.advisors-grid[data-shuffle], .advisory-grid[data-shuffle]');
    grids.forEach((grid) => {
      const cards = Array.from(grid.children).filter((el) => el.classList.contains('advisor-card'));
      for (let i = cards.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [cards[i], cards[j]] = [cards[j], cards[i]];
      }
      cards.forEach((card, i) => {
        (card as HTMLElement).style.transitionDelay = `${i * 150}ms`;
        grid.appendChild(card);
      });
      requestAnimationFrame(() => {
        requestAnimationFrame(() => grid.classList.add('is-revealed'));
      });
    });
  })();

  (() => {
    const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.about-tab'));
    if (!tabs.length) return;
    const sections = tabs
      .map((tab) => document.getElementById(tab.dataset.target ?? ''))
      .filter((el): el is HTMLElement => el !== null);
    if (!sections.length) return;

    const setActive = (id: string) => {
      tabs.forEach((tab) => {
        tab.classList.toggle('active', tab.dataset.target === id);
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-140px 0px -55% 0px', threshold: [0, 0.25, 0.5, 0.75, 1] }
    );
    sections.forEach((s) => observer.observe(s));

    tabs.forEach((tab) => {
      tab.addEventListener('click', (e) => {
        e.preventDefault();
        const targetId = tab.dataset.target;
        if (!targetId) return;
        const target = document.getElementById(targetId);
        if (!target) return;
        setActive(targetId);
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.replaceState(null, '', '#' + targetId);
      });
    });
  })();

  (() => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.advisor-expand');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('aria-controls');
        if (!targetId) return;
        const panel = document.getElementById(targetId);
        if (!panel) return;
        const label = btn.querySelector('.expand-label');
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        if (isOpen) {
          btn.setAttribute('aria-expanded', 'false');
          panel.setAttribute('hidden', '');
          if (label) label.textContent = 'Full Profile';
        } else {
          btn.setAttribute('aria-expanded', 'true');
          panel.removeAttribute('hidden');
          if (label) label.textContent = 'Collapse';
        }
      });
    });
  })();
</script>
